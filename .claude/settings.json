{
  "$comment": "Pre-approves the kit's own local commands, exactly as the docs run them, so routine steps need no repeated prompt: the kit's scripts (engine start/stop/status/restart/jobs/delete, scrape.py, scrape.sh, the offline tests) and docker compose in this folder in the exact forms the docs use. Everything else, curl included, asks the user as usual. The PostToolUse hook shows the user the first rows of each file scrape.py saves, as a notice Claude Code does not send to the model (scripts/preview_hook.py; the same hook is in .codex/hooks.json, .gemini/settings.json and the skill's frontmatter).",
  "permissions": {
    "allow": [
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d --build)",
      "Bash(docker compose up -d --build --remove-orphans)",
      "Bash(docker compose down)",
      "Bash(docker compose down --remove-orphans)",
      "Bash(docker compose stop)",
      "Bash(docker compose start)",
      "Bash(docker compose restart)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs)",
      "Bash(docker ps)",
      "Bash(python3 scripts/test_scrape.py)",
      "Bash(python3 scripts/engine.py start)",
      "Bash(python3 scripts/engine.py stop)",
      "Bash(python3 scripts/engine.py status)",
      "Bash(python3 scripts/engine.py restart)",
      "Bash(python3 scripts/engine.py jobs)",
      "Bash(python3 scripts/engine.py delete:*)",
      "Bash(python scripts/engine.py start)",
      "Bash(python scripts/engine.py stop)",
      "Bash(python scripts/engine.py status)",
      "Bash(python scripts/engine.py restart)",
      "Bash(python scripts/engine.py jobs)",
      "Bash(python scripts/engine.py delete:*)",
      "Bash(py scripts/engine.py start)",
      "Bash(py scripts/engine.py stop)",
      "Bash(py scripts/engine.py status)",
      "Bash(py scripts/engine.py restart)",
      "Bash(py scripts/engine.py jobs)",
      "Bash(py scripts/engine.py delete:*)",
      "Bash(python3 engine/test_engine.py)",
      "Bash(python3 engine/test_cdp.py)",
      "Bash(./scripts/scrape.sh:*)",
      "Bash(bash scripts/scrape.sh:*)",
      "Bash(python3 scripts/scrape.py:*)",
      "Bash(python scripts/scrape.py:*)",
      "Bash(py scripts/scrape.py:*)",
      "Bash(python3 scripts/leads.py:*)",
      "Bash(python scripts/leads.py:*)",
      "Bash(py scripts/leads.py:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 scripts/preview_hook.py 2>/dev/null || python scripts/preview_hook.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
