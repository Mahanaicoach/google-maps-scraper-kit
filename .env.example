# Local config for the kit. Copy it to ".env" and edit only what you need:  cp .env.example .env
#
# No API key is required. The engine listens on 127.0.0.1 only, so other machines cannot reach it,
# and it refuses requests whose Host or Origin is not localhost (web pages in your browser).

# Port the engine serves on, with or without Docker. Default: 8080. Change this line (do not add a
# second one) if 8080 is already taken, then start the engine again (python3 scripts/engine.py
# restart, or docker compose up -d). The engine, compose and the scripts all read it from this file.
SCRAPER_PORT=8080

# Full URL of the engine's API. Default: unset, so the scripts use http://localhost:<SCRAPER_PORT>.
# Set it only if the engine runs somewhere else. When set, the scripts ignore SCRAPER_PORT.
# SCRAPER_BASE_URL=http://localhost:8080

# A second copy of the kit on the same machine (your fork next to the original, a test clone):
# change SCRAPER_PORT above to a free port. That is all scripts/engine.py needs: each copy keeps its
# own .engine/ folder. With Docker, also give the copy its own Compose project name, or
# "docker compose up -d" takes over the other copy's container ("docker compose ls" lists the
# names in use; your initials or the folder name work well):
# COMPOSE_PROJECT_NAME=gmaps-kit-mj

# Optional key. When set, the engine answers only requests with this value in an X-API-Key header,
# and the scripts send it. Default: blank, which is right for local use. The web UI asks for it.
SCRAPER_API_KEY=

# Window mode. Default: unset, so Chrome runs headless and Google shows it its "limited view":
# review_count, open_hours and reviews_link stay empty. Set it to 0 to run Chrome as a normal
# window placed off-screen, which Google gives its full view, so those are filled (and jobs with
# reviews_max get reviews). Then restart the engine (python3 scripts/engine.py restart). It needs a
# desktop with a display and an installed Chrome, Chromium, Edge or Brave; Docker's image stays
# headless. On macOS a second Chrome icon shows in the Dock, and the window may take focus when a
# job starts. No user agent is changed.
# SCRAPER_HEADLESS=0
